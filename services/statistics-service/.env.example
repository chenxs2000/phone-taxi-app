# MongoDB 连接
MONGODB_URI=mongodb://localhost:27017/phone-taxi

# 服务端口
PORT=3006

# RabbitMQ 配置
RABBITMQ_URI=amqp://localhost:5672
RABBITMQ_QUEUE=statistics_queue
RABBITMQ_EXCHANGE=phone_taxi_exchange

# 数据同步配置
DATA_SYNC_INTERVAL=3600000

# 报表导出配置
EXPORT_STORAGE_TYPE=local
EXPORT_STORAGE_PATH=/exports
