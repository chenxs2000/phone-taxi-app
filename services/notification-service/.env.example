# 短信服务配置 (示例)
SMS_SERVICE_ACCESS_KEY=
SMS_SERVICE_SECRET_KEY=
SMS_SERVICE_SIGN_NAME=

# 邮件服务配置 (示例)
EMAIL_SERVICE_HOST=
EMAIL_SERVICE_PORT=587
EMAIL_SERVICE_USER=
EMAIL_SERVICE_PASSWORD=
