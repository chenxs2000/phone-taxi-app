# API Gateway - 生产环境配置示例
# Phone Taxi App - Production Environment Configuration Example
# ⚠️ 重要：复制此文件为 .env.production 并填入真实的配置值

# ============== API 配置 ==============
API_GATEWAY_URL=https://api.phone-taxi.app/api

# ============== 应用配置 ==============
NODE_ENV=production
LOG_LEVEL=info

# ============== JWT 配置 ==============
# ⚠️ 重要：使用强随机密钥，至少 32 位字符
JWT_SECRET=${PROD_JWT_SECRET_PLACEHOLDER}
JWT_EXPIRES_IN=7d

# ============== 服务 URL 配置 ==============
# 生产环境使用实际的生产服务端点
USER_SERVICE_URL=http://user-service.production.internal:3001
ORDER_SERVICE_URL=http://order-service.production.internal:3002
DISPATCH_SERVICE_URL=http://dispatch-service.production.internal:3003
PAYMENT_SERVICE_URL=http://payment-service.production.internal:3004
NOTIFICATION_SERVICE_URL=http://notification-service.production.internal:3005
STATISTICS_SERVICE_URL=http://statistics-service.production.internal:3006
CALL_SERVICE_URL=http://call-service.production.internal:3007

# ============== 数据库配置 ==============
# MongoDB 生产配置（使用副本集和认证）
# 格式: mongodb://username:password@host:port/database?authSource=admin
MONGODB_URI=${PROD_MONGODB_URI_PLACEHOLDER}

# Redis 生产配置（使用密码）
REDIS_URI=redis://${PROD_REDIS_PASSWORD_PLACEHOLDER}@prod-redis.internal:6379

# RabbitMQ 生产配置（使用强密码）
RABBITMQ_URI=amqp://${PROD_RABBITMQ_USER}:${PROD_RABBITMQ_PASSWORD}@prod-rabbitmq.internal:5672

# ============== 其他配置 ==============
PORT=3000

# ============== 监控配置 ==============
# Prometheus 指标端点
PROMETHEUS_ENDPOINT=http://prometheus.monitoring.internal:9090/metrics

# Grafana 仪表板
GRAFANA_DASHBOARD=https://grafana.monitoring.internal

# Sentry 错误追踪
SENTRY_DSN=${PROD_SENTRY_DSN_PLACEHOLDER}

# ============== 限流配置 ==============
# 生产环境更严格的限制
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=50

# ============== CORS 配置 ==============
# 生产环境限制 CORS 源
CORS_ORIGINS=https://phone-taxi.app,https://admin.phone-taxi.app

# ============== 安全配置 ==============
HTTPS_ENABLED=true

# SSL/TLS 配置
SSL_CERT_PATH=/etc/ssl/certs/phone-taxi.crt
SSL_KEY_PATH=/etc/ssl/certs/phone-taxi.key

# ============== 功能标志 ==============
FEATURE_SWAGGER_ENABLED=false
FEATURE_RATE_LIMIT_ENABLED=true
FEATURE_CACHING_ENABLED=true
FEATURE_LOGGING_ENABLED=true

# ============== 性能配置 ==============
# 缓存 TTL（秒）
CACHE_TTL=300

# 连接超时配置（秒）
MONGODB_TIMEOUT=5000
REDIS_TIMEOUT=2000
RABBITMQ_TIMEOUT=10000

# ============== 部署配置 ==============
DEPLOYMENT_ENV=production
DEPLOYMENT_VERSION=${PROD_DEPLOYMENT_VERSION_PLACEHOLDER}
DEPLOYMENT_TIMESTAMP=${PROD_DEPLOYMENT_TIMESTAMP_PLACEHOLDER}

# ============== 备份配置 ==============
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 2 * * *  # 每天凌晨 2 点执行备份

# ============== CDN 配置 ==============
CDN_ENABLED=true
CDN_URL=https://cdn.phone-taxi.app
CDN_ASSETS_PATH=/assets
