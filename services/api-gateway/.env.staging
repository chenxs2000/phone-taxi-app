# API Gateway - 测试环境配置
# Phone Taxi App - Staging Environment Configuration

# ============== API 配置 ==============
API_GATEWAY_URL=http://localhost:3000/api

# ============== 应用配置 ==============
NODE_ENV=staging
LOG_LEVEL=debug
NODE_ENV=development

# ============== JWT 配置 ==============
JWT_SECRET=staging-test-secret-key-do-not-use-in-production
JWT_EXPIRES_IN=7d

# ============== 服务 URL 配置 ==============
# 测试环境使用本地服务（如果使用 Docker，需要调整）
USER_SERVICE_URL=http://localhost:3001
ORDER_SERVICE_URL=http://localhost:3002
DISPATCH_SERVICE_URL=http://localhost:3003
PAYMENT_SERVICE_URL=http://localhost:3004
NOTIFICATION_SERVICE_URL=http://localhost:3005
STATISTICS_SERVICE_URL=http://localhost:3006
CALL_SERVICE_URL=http://localhost:3007

# ============== 数据库配置 ==============
# MongoDB 配置
MONGODB_URI=mongodb://admin:password123@localhost:27017/phone-taxi-staging?authSource=admin

# Redis 配置
REDIS_URI=redis://localhost:6379

# RabbitMQ 配置
RABBITMQ_URI=amqp://admin:password@localhost:5672

# ============== 其他配置 ==============
PORT=3000

# ============== 监控配置 ==============
# Prometheus 指标端点（如配置）
# PROMETHEUS_ENDPOINT=http://localhost:9090/metrics

# ============== 限流配置 ==============
# 速率限制配置（分钟请求数）
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ============== CORS 配置 ==============
# CORS 允许的源（测试环境允许所有源）
CORS_ORIGINS=*

# ============== 安全配置 ==============
# 是否启用 HTTPS（生产环境为 true）
HTTPS_ENABLED=false

# ============== 功能标志 ==============
# 功能开关
FEATURE_SWAGGER_ENABLED=true
FEATURE_RATE_LIMIT_ENABLED=true
FEATURE_CACHING_ENABLED=true
FEATURE_LOGGING_ENABLED=true

# ============== 测试配置 ==============
# 是否启用测试端点
TEST_ENDPOINTS_ENABLED=true

# Mock 数据（用于测试）
# MOCK_EXTERNAL_SERVICES=false

# ============== 部署配置 ==============
# 部署环境标识
DEPLOYMENT_ENV=staging
DEPLOYMENT_VERSION=$(date +%Y.%m.%d)-$(git rev-parse --short HEAD)
DEPLOYMENT_TIMESTAMP=$(date -u +%Y-%m-%dT%H:%M:%SZ)
