# MongoDB 连接
MONGODB_URI=mongodb://localhost:27017/phone-taxi

# 服务端口
PORT=3007

# RabbitMQ 配置
RABBITMQ_URI=amqp://localhost:5672
RABBITMQ_QUEUE=call_queue
RABBITMQ_EXCHANGE=phone_taxi_exchange

# 云通信服务配置 (示例 - 阿里云语音服务)
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_VOICE_REGION=cn-hangzhou
ALIYUN_VOICE_APP_ID=

# 录音存储配置
RECORDING_STORAGE_TYPE=oss
OSS_BUCKET=
OSS_REGION=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
